@model DashboardViewModel
@{
    ViewData["Title"] = "Painel";
}

@* =========================================================================
   Cabeçalho do painel
   ========================================================================= *@
<div class="mb-4">
    <h1 class="h3 mb-1">Painel de Capital Imobilizado</h1>
    <p class="text-muted mb-0">
        Produtos sem venda há mais de <strong>@Model.DiasLimite dias</strong>
        e o valor financeiro parado em estoque.
    </p>
</div>

@* =========================================================================
   Cartões de resumo
   - Total imobilizado: soma de (estoque × custo) dos produtos parados
   - Produtos parados / ativos: contagem de cada grupo
   ========================================================================= *@
<div class="row g-3 mb-4">
    @* Cartão de alerta (vermelho da marca): valor financeiro parado *@
    <div class="col-12 col-md-4">
        <div class="card ns-card ns-card-alerta h-100">
            <div class="card-body">
                <div class="ns-card-rotulo">Capital imobilizado</div>
                <div class="ns-card-valor">@Model.TotalImobilizado.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card ns-card h-100">
            <div class="card-body">
                <div class="ns-card-rotulo">Produtos parados</div>
                <div class="ns-card-valor">@Model.QuantidadeParados</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card ns-card h-100">
            <div class="card-body">
                <div class="ns-card-rotulo">Produtos ativos</div>
                <div class="ns-card-valor">@Model.QuantidadeAtivos</div>
            </div>
        </div>
    </div>
</div>

@* =========================================================================
   Tabela de produtos parados
   Já vem ordenada pelo serviço: maior valor imobilizado primeiro.
   ========================================================================= *@
<h2 class="h5 mb-3">Produtos parados</h2>

@if (Model.ProdutosParados.Count == 0)
{
    @* Caso não exista nenhum produto acima do limite *@
    <div class="alert alert-success">Nenhum produto parado. Estoque saudável!</div>
}
else
{
    <div class="table-responsive ns-tabela mb-2">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th class="text-end">Estoque</th>
                    <th class="text-end">Custo unitário</th>
                    <th class="text-end">Preço de venda</th>
                    <th class="text-center">Última venda</th>
                    <th class="text-center">Dias sem venda</th>
                    <th class="text-end">Valor imobilizado</th>
                    <th class="text-center">Promoção</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var produto in Model.ProdutosParados)
                {
                    // Destaque visual: vermelho da marca acima de 1 ano, amarelo nos demais
                    var classeDias = produto.DiasSemVenda > 365 ? "ns-selo-critico" : "ns-selo-atencao";

                    <tr>
                        <td>@produto.NomeProduto</td>
                        <td class="text-end">@produto.QuantidadeEstoque</td>
                        <td class="text-end">@produto.CustoUnitario.ToString("C")</td>
                        <td class="text-end">@produto.PrecoVenda.ToString("C")</td>
                        <td class="text-center">@produto.DataUltimaVenda.ToString("d")</td>
                        <td class="text-center">
                            <span class="badge @classeDias">@produto.DiasSemVenda dias</span>
                        </td>
                        <td class="text-end fw-semibold">@produto.ValorImobilizado.ToString("C")</td>
                        <td class="text-center">
                            @* O id e o nome do produto ficam em atributos data-* para o JavaScript *@
                            <button type="button" class="btn btn-sm btn-outline-primary btn-sugerir-promocao text-nowrap"
                                    data-id="@produto.IdProduto" data-nome="@produto.NomeProduto">
                                Sugerir promoção
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @* Linha de total, repetindo o valor do cartão de resumo *@
                <tr class="fw-bold">
                    <td colspan="6" class="text-end">Total imobilizado</td>
                    <td class="text-end">@Model.TotalImobilizado.ToString("C")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <p class="small text-muted">
        <span class="badge ns-selo-atencao">amarelo</span> mais de @Model.DiasLimite dias ·
        <span class="badge ns-selo-critico">vermelho</span> mais de 365 dias sem venda
    </p>
}

@* =========================================================================
   Token antiforgery: campo oculto gerado pelo ASP.NET Core. O JavaScript
   o envia em cada POST para comprovar que a requisição partiu desta página.
   ========================================================================= *@
@Html.AntiForgeryToken()

@* =========================================================================
   Modal (janela) que exibe a sugestão de promoção
   Os campos são preenchidos pelo JavaScript abaixo com a resposta do servidor.
   ========================================================================= *@
<div class="modal fade" id="modalPromocao" tabindex="-1" aria-labelledby="modalPromocaoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header ns-modal-cabecalho">
                <h5 class="modal-title" id="modalPromocaoTitulo">Sugestão de promoção</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                @* Produto, tipo de promoção e origem (IA ou padrão) *@
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <strong id="promoProduto" class="me-auto"></strong>
                    <span id="promoTipo" class="badge ns-promo-tipo"></span>
                    <span id="promoOrigem" class="badge"></span>
                </div>

                @* Preço "de/por" e desconto *@
                <div class="ns-promo-preco mb-3">
                    <div>
                        <div class="small text-muted">De</div>
                        <div class="ns-promo-de" id="promoPrecoDe"></div>
                    </div>
                    <div class="ns-promo-seta" aria-hidden="true">→</div>
                    <div>
                        <div class="small text-muted">Por</div>
                        <div class="ns-promo-por" id="promoPrecoPor"></div>
                    </div>
                    <div class="ns-promo-desconto" id="promoDesconto"></div>
                </div>

                @* Indicadores calculados pelo sistema *@
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="ns-promo-indicador">
                            <div class="small text-muted">Lucro por unidade</div>
                            <div class="fw-bold" id="promoLucro"></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="ns-promo-indicador">
                            <div class="small text-muted">Valor a recuperar (estoque todo)</div>
                            <div class="fw-bold" id="promoRecuperavel"></div>
                        </div>
                    </div>
                </div>

                @* Aviso exibido somente quando o sistema corrigiu o preço (piso = custo) *@
                <div class="alert alert-warning py-2 small d-none" id="promoAvisoPiso">
                    O preço foi limitado ao custo unitário: a loja não vende com prejuízo.
                </div>

                @* Justificativa da escolha *@
                <p class="small fst-italic text-muted mb-3" id="promoJustificativa"></p>

                @* Área de texto editável: o usuário pode ajustar antes de copiar *@
                <label for="promoMensagem" class="form-label fw-semibold">Mensagem para divulgação</label>
                <textarea id="promoMensagem" class="form-control" rows="4"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" id="btnCopiarMensagem">Copiar mensagem</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // =====================================================================
        // Sugestão de promoção
        // Ao clicar em "Sugerir promoção", envia um POST para a Controller e
        // exibe a sugestão retornada no modal.
        // Segurança: os textos vindos da IA são inseridos com textContent
        // (nunca innerHTML), para que nenhum conteúdo seja executado como código.
        // =====================================================================
        (function () {
            const modal = new bootstrap.Modal(document.getElementById('modalPromocao'));
            const el = (id) => document.getElementById(id);
            const btnCopiar = el('btnCopiarMensagem');

            // Formatação de valores no padrão brasileiro (R$ 1.234,56 e 12,5%)
            const moeda = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
            const numero = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 1 });

            // Lê o token antiforgery do campo oculto gerado por @@Html.AntiForgeryToken()
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Preenche o modal com a sugestão recebida do servidor
            function exibirSugestao(nomeProduto, s) {
                el('promoProduto').textContent = nomeProduto;
                el('promoTipo').textContent = s.tipoPromocao;

                // Indica se a sugestão veio da IA ou é a padrão da loja
                const origem = el('promoOrigem');
                origem.textContent = s.geradaPorIA ? 'Sugerida por IA (Gemini)' : 'Sugestão padrão (IA indisponível)';
                origem.className = 'badge ' + (s.geradaPorIA ? 'bg-success' : 'bg-secondary');

                el('promoPrecoDe').textContent = moeda.format(s.precoOriginal);
                el('promoPrecoPor').textContent = moeda.format(s.precoPromocional);
                el('promoDesconto').textContent = '-' + numero.format(s.descontoPercentual) + '%';

                el('promoLucro').textContent = moeda.format(s.lucroUnitario)
                    + ' (' + numero.format(s.margemSobreCustoPercentual) + '% sobre o custo)';
                el('promoRecuperavel').textContent = moeda.format(s.valorRecuperavel);

                el('promoAvisoPiso').classList.toggle('d-none', !s.precoAjustadoPeloPiso);
                el('promoJustificativa').textContent = s.justificativa;
                el('promoMensagem').value = s.mensagem;

                btnCopiar.textContent = 'Copiar mensagem';
                modal.show();
            }

            document.querySelectorAll('.btn-sugerir-promocao').forEach(function (botao) {
                botao.addEventListener('click', async function () {
                    const textoOriginal = botao.textContent;

                    // Enquanto aguarda a IA, desabilita o botão e mostra "Analisando…"
                    botao.disabled = true;
                    botao.textContent = 'Analisando…';

                    try {
                        const resposta = await fetch('/Dashboard/SugerirPromocao/' + botao.dataset.id, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token }
                        });

                        if (!resposta.ok) {
                            throw new Error('HTTP ' + resposta.status);
                        }

                        exibirSugestao(botao.dataset.nome, await resposta.json());
                    } catch (erro) {
                        alert('Não foi possível gerar a sugestão. Tente novamente.');
                        console.error(erro);
                    } finally {
                        // Restaura o botão em qualquer situação (sucesso ou erro)
                        botao.disabled = false;
                        botao.textContent = textoOriginal;
                    }
                });
            });

            // Copia a mensagem (já com eventuais ajustes do usuário) para a área de transferência
            btnCopiar.addEventListener('click', async function () {
                await navigator.clipboard.writeText(el('promoMensagem').value);
                btnCopiar.textContent = 'Copiado!';
            });
        })();
    </script>
}
